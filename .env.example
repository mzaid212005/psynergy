# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/psynergy
POSTGRES_PASSWORD=your_secure_password_here

# Authentication
NEXTAUTH_SECRET=your-super-secret-key-here-minimum-32-characters
NEXTAUTH_URL=http://localhost:3000

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (Alternative to local database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Crisis Support Configuration
CRISIS_HELPLINE=7892707757
EMERGENCY_NUMBER=112
CRISIS_TEXT_LINE=741741

# Monitoring and Analytics (Optional)
SENTRY_DSN=your_sentry_dsn_here
VERCEL_ANALYTICS_ID=your_vercel_analytics_id
GOOGLE_ANALYTICS_ID=your_google_analytics_id

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379

# File Storage (Optional - for user uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here
JWT_SECRET=your-jwt-secret-key-here

# Feature Flags
ENABLE_CHAT=true
ENABLE_ASSESSMENTS=true
ENABLE_APPOINTMENTS=true
ENABLE_COMMUNITY=true
ENABLE_ADMIN_DASHBOARD=true

# Development Tools
LOG_LEVEL=info
DEBUG_MODE=false

# Grafana (for monitoring)
GRAFANA_PASSWORD=admin_password_here

# College-Specific Configuration
COLLEGE_NAME=Your College Name
COLLEGE_CODE=YCN
USN_PATTERN=^[0-9][A-Z]{2}[0-9]{2}[A-Z]{2}[0-9]{3}$
ACADEMIC_YEAR_START=2024-06-01
ACADEMIC_YEAR_END=2025-05-31

# Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
NOTIFICATION_FROM_EMAIL=noreply@your-domain.com
NOTIFICATION_FROM_NAME=Psynergy Support

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Performance Configuration
MAX_UPLOAD_SIZE=10485760
SESSION_TIMEOUT=3600000
CACHE_TTL=300

# Compliance and Privacy
DATA_RETENTION_DAYS=2555
ENABLE_GDPR_COMPLIANCE=true
ENABLE_AUDIT_LOGGING=true
PRIVACY_POLICY_URL=https://your-domain.com/privacy
TERMS_OF_SERVICE_URL=https://your-domain.com/terms
